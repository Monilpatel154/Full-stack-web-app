# Database Configuration (PostgreSQL)
# Option 1: Connection string URL (recommended for Render, Supabase, Neon, AWS RDS, Railway, etc.)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ladli_db
# Option 2: Individual connection parameters
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=ladli_db
# PGUSER=postgres
# PGPASSWORD=your-postgres-password
# PGSSLMODE=prefer

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_EMAIL=you@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM_EMAIL=your-email@gmail.com
MAIL_FROM_NAME=LADLI Electrical Testing and Calibration Laboratory
MAIL_REPLY_TO=your-email@gmail.com
